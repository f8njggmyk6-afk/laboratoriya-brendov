# Replace example.invalid and the certificate paths before enabling this file.
# Obtain and validate the site's TLS certificate first.
server {
    listen 80;
    server_name example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.invalid;

    ssl_certificate     /etc/letsencrypt/live/example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.invalid/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite the client-supplied value; the app trusts this header for rate limits.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
